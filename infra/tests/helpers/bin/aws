#!/usr/bin/env bash
# Test stub for aws (backup.bats). A bucket is a directory under $STUB_S3_ROOT; every call is
# appended to $STUB_LOG. Supports what backup.sh uses: s3 cp, s3 mv, s3 rm, s3api list-objects-v2
# (text "Key<TAB>LastModified" lines) and s3api delete-object. --endpoint-url, --only-show-errors,
# --query and --output are accepted and ignored apart from being logged.
set -euo pipefail

echo "aws $*" >>"$STUB_LOG"

args=()
while [ $# -gt 0 ]; do
  case "$1" in
    --endpoint-url | --query | --output) shift 2 ;;
    --only-show-errors) shift ;;
    *) args+=("$1"); shift ;;
  esac
done
set -- "${args[@]}"

path() { # s3://bucket/key -> local path; anything else unchanged
  case "$1" in s3://*) printf '%s/%s' "$STUB_S3_ROOT" "${1#s3://}" ;; *) printf '%s' "$1" ;; esac
}

case "$1 $2" in
  "s3 cp")
    mkdir -p "$(dirname "$(path "$4")")"
    cp "$(path "$3")" "$(path "$4")"
    ;;
  "s3 mv")
    mkdir -p "$(dirname "$(path "$4")")"
    mv "$(path "$3")" "$(path "$4")"
    rmdir "$(dirname "$(path "$3")")" 2>/dev/null || true # S3 has no directories
    ;;
  "s3 rm") rm -f "$(path "$3")" ;;
  "s3api list-objects-v2")
    bucket="" prefix=""
    shift 2
    while [ $# -gt 0 ]; do
      case "$1" in
        --bucket) bucket="$2"; shift 2 ;;
        --prefix) prefix="$2"; shift 2 ;;
        *) shift ;;
      esac
    done
    root="$STUB_S3_ROOT/$bucket"
    [ -d "$root" ] || exit 0
    (cd "$root" && find "$prefix" -type f 2>/dev/null) | while IFS= read -r key; do
      printf '%s\t%s\n' "$key" "$(date -u -d "@$(stat -c %Y "$root/$key")" +%Y-%m-%dT%H:%M:%S+00:00)"
    done
    ;;
  "s3api delete-object")
    shift 2
    while [ $# -gt 0 ]; do
      case "$1" in
        --bucket) bucket="$2"; shift 2 ;;
        --key) key="$2"; shift 2 ;;
        *) shift ;;
      esac
    done
    rm -f "$STUB_S3_ROOT/$bucket/$key"
    ;;
  *) echo "aws stub: unsupported: $*" >&2; exit 1 ;;
esac
