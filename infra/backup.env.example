# Copy to backup.env on the instance, next to .env (chmod 600, owner deploy). Never commit backup.env.
# Read only by backup.sh and restore.sh on the host; never passed to a container (the api's
# env_file is .env). Values without quotes.
# Amazon S3 bucket name. Leave the endpoint empty for AWS S3; set it only for an S3-compatible store.
BACKUP_S3_BUCKET=
BACKUP_S3_ENDPOINT=
# Access key of the IAM user restricted to the bucket's daily/ prefix (see docs/runbook.md, section 9).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
