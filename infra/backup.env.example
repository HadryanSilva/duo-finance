# Copy to backup.env on the instance, next to .env (chmod 600, owner deploy). Never commit backup.env.
# Read only by backup.sh and restore.sh on the host; never passed to a container (the api's
# env_file is .env). Values without quotes.
# Lightsail Object Storage (S3 compatible): bucket name and endpoint (https://s3.<region>.amazonaws.com).
BACKUP_S3_BUCKET=
BACKUP_S3_ENDPOINT=
# Access key restricted to that bucket.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
