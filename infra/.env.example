# Copy to .env on the instance (chmod 600). Never commit .env.
# Image tag deployed by the pipeline: 12-char commit sha.
IMAGE_TAG=

# Postgres container.
POSTGRES_DB=duofinance
POSTGRES_USER=duofinance
POSTGRES_PASSWORD=

# Backend datasource. To move to a managed database, change only these three.
DB_URL=jdbc:postgresql://postgres:5432/duofinance
DB_USER=duofinance
DB_PASSWORD=

# Public origin used in e-mail links.
PUBLIC_BASE_URL=https://duofinance.dev.br

# Single-line PEM keys: run infra/scripts/gen-jwt-keys.sh and paste its two lines here.
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=

# Resend (transactional e-mail).
RESEND_API_KEY=
EMAIL_FROM=Duo Finance <no-reply@duofinance.dev.br>

# Backup (Lightsail Object Storage, S3 compatible).
BACKUP_S3_BUCKET=
BACKUP_S3_ENDPOINT=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
